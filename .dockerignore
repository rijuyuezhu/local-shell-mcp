# Keep the Docker build context small and avoid reading runtime/user workspaces.
# The Dockerfile only needs these files/directories from the repository.
**

!Dockerfile
!pyproject.toml
!uv.lock
!README.md
!LICENSE

!src/
!src/**

!scripts/
!scripts/docker-entrypoint.sh

!ui-opentui/
!ui-opentui/package.json
!ui-opentui/bun.lock
!ui-opentui/tsconfig.json
!ui-opentui/scripts/
!ui-opentui/scripts/**
!ui-opentui/src/
!ui-opentui/src/**
